{
    "name": "kassko/data-mapper",
    "description": "A minimal PHP 8.1+ data-mapper library with attributes and lazy loading",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name":"kassko"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/container": "^1.1|^2.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "psr/simple-cache": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "symfony/console": "^5.4|^6.0|^7.0",
        "symfony/finder": "^5.4|^6.0|^7.0"
    },
    "suggest": {
        "symfony/console": "Required for build-time metadata validation commands",
        "symfony/finder": "Required for build-time metadata validation commands"
    },
    "autoload": {
        "psr-4": {
            "Kassko\\DataMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kassko\\DataMapper\\Tests\\": "tests/",
            "Kassko\\Sample\\": "tests/Fixtures/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
