{
    "name": "kassko/data-mapper",
    "description": "A minimal PHP 8.1+ data-mapper library with attributes and lazy loading",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name":"kassko"
        }
    ],
    "keywords": [
        "mapper",
        "data",
        "object",
        "lazy",
        "loading",
        "hydration",
        "source",
        "model",
        "lineage",
        "orm",
        "entity",
        "repository",
        "dao"
    ],
    "require": {
        "php": ">=8.1",
        "psr/container": "^1.1|^2.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "psr/simple-cache": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "symfony/console": "^5.4|^6.0|^7.0",
        "symfony/finder": "^5.4|^6.0|^7.0"
    },
    "suggest": {
        "symfony/console": "Required for build-time metadata validation commands",
        "symfony/finder": "Required for build-time metadata validation commands"
    },
    "autoload": {
        "psr-4": {
            "Kassko\\DataMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kassko\\DataMapper\\Tests\\": "tests/",
            "Kassko\\DataMapper\\Tests\\Fixtures\\": "tests/Integration/Features/Priority/Fixtures/",
            "Kassko\\Sample\\Cascade\\": "tests/Integration/Features/AttributeCascade/Fixtures/",
            "Kassko\\Sample\\KeepSkip\\": "tests/Integration/Attributes/Keep_Skip_KeepAll_SkipAll/Fixtures/",
            "Kassko\\Sample\\DataSourceRefProviders\\": "tests/Integration/Attributes/DataSourceRef_Providers/Fixtures/",
            "Kassko\\Sample\\DataSourceStore\\": "tests/Integration/Attributes/DataSourceStore/Fixtures/",
            "Kassko\\Sample\\DataSourceChain\\": "tests/Integration/Attributes/DataSource_Chain/Fixtures/",
            "Kassko\\Sample\\DataSourceLoadingScope\\": "tests/Integration/Attributes/DataSource_LoadingScope/Fixtures/",
            "Kassko\\Sample\\Hook\\": "tests/Integration/Attributes/Hook/Fixtures/",
            "Kassko\\Sample\\HookExternalService\\": "tests/Integration/Attributes/Hook_ExternalService/Fixtures/",
            "Kassko\\Sample\\LoadingDepth\\": "tests/Integration/Attributes/Loading_Depth/Fixtures/",
            "Kassko\\Sample\\LoadingEager\\": "tests/Integration/Attributes/Loading_Eager/Fixtures/",
            "Kassko\\Sample\\MultiPropDataSource\\": "tests/Integration/Attributes/MultiPropDataSource/Fixtures/",
            "Kassko\\Sample\\PropertyConfigCandidates\\": "tests/Integration/Attributes/Property_ConfigCandidates/Fixtures/",
            "Kassko\\Sample\\PropertyExpandNoExpand\\": "tests/Integration/Attributes/Property_ExpandNoExpand/Fixtures/",
            "Kassko\\Sample\\PropertyMapping\\": "tests/Integration/Attributes/Property_Mapping/Fixtures/",
            "Kassko\\Sample\\ServiceLocator\\": "tests/Integration/Classes/ServiceLocator/Fixtures/",
            "Kassko\\Sample\\DataMapperClass\\": "tests/Integration/Classes/DataMapper/Fixtures/",
            "Kassko\\Sample\\CustomHydrator\\": "tests/Integration/Features/CustomHydrator/Fixtures/",
            "Kassko\\Sample\\DifferentSignatures\\": "tests/Integration/Features/DifferentSignatures/Fixtures/",
            "Kassko\\Sample\\ExpressionLanguage\\": "tests/Integration/Features/ExpressionLanguage/Fixtures/",
            "Kassko\\Sample\\Features\\ParentClassHydration\\": "tests/Integration/Features/ParentClassHydration/Fixtures/",
            "Kassko\\Sample\\Features\\RecursiveHydration\\": "tests/Integration/Features/RecursiveHydration/Fixtures/",
            "Kassko\\Sample\\Registry\\": "tests/Integration/Features/Registry/Fixtures/",
            "Kassko\\Sample\\TraitHydration\\": "tests/Integration/Features/TraitHydration/Fixtures/",
            "Kassko\\Sample\\UseCases\\": "tests/Integration/UseCases/Fixtures/",
            "Kassko\\Sample\\AttributeReader\\": "tests/Unit/AttributeReader/Fixtures/",
            "Kassko\\Sample\\Hydrator\\": "tests/Unit/Hydrator/Fixtures/",
            "Kassko\\Sample\\Loader\\": "tests/Unit/Loader/Fixtures/",
            "Kassko\\Sample\\LoaderValidation\\": "tests/Unit/LoaderValidation/Fixtures/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
